{
  "name": "nodejs-typescript",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc --build",
    "start": "node dist/main.js",
    "type-check": "tsc --build --noEmit",
    "lint:oxlint": "oxlint --fix src/",
    "lint:eslint": "eslint --fix --cache src/",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "format": "oxfmt --no-error-on-unmatched-pattern src/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.1.0-dev.20261123.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.94.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
